<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestorbutacas.MainController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Gestión de Butacas de Cine" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Button text="Mostrar sala" onAction="#mostrarSala"/>
    <TextArea fx:id="areaSala" editable="false" prefRowCount="8"/>
</VBox>